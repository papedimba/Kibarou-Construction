APP_ENV=production
APP_DEBUG=0
# Hôte de l'administration centrale (/platform)
PLATFORM_HOST=platform.kibarouconstruction.com
# Domaine de base pour les sous-domaines <slug>.<base>
PLATFORM_BASE_DOMAIN=kibarouconstruction.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kibarou_cms
DB_USER=kibarou
DB_PASS=change-me
# Clé secrète (aléatoire, 32+ caractères) : signe les jetons antispam
APP_KEY=
# log = écrit dans storage/logs/mail.log ; mail = fonction mail() de PHP (cPanel)
MAIL_DRIVER=mail
MAIL_FROM=no-reply@kibarouconstruction.com
